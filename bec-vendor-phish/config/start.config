# Labtainers current format (GLOBAL_SETTINGS / NETWORK / CONTAINER blocks).
# Registry for this lab's published images; base images remain in the official registry.
GLOBAL_SETTINGS
    LAB_MASTER_SEED bec_vendor_phish_master_seed
    GRADE_CONTAINER mail-server
    REGISTRY meme23102003
    BASE_REGISTRY labtainers
NETWORK BEC_LAN
    MASK 172.25.0.0/24
    GATEWAY 172.25.0.1
CONTAINER mail-server
    USER student
    X11 NO
    PASSWORD password123
    BEC_LAN 172.25.0.2
    TERMINALS 1
    NO_GW YES
    NO_RESOLVE YES
CONTAINER victim-pc
    USER student
    X11 NO
    PASSWORD password123
    BEC_LAN 172.25.0.3
    TERMINALS 1
    NO_GW YES
    NO_RESOLVE YES
