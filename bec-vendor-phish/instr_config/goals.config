# goals.config
ceo_sent      = boolean : ( evt_ceo_email_sent )
vendor_sent   = boolean : ( evt_vendor_email_sent )
read_ceo      = boolean : ( evt_victim_read_ceo )
read_vendor   = boolean : ( evt_victim_read_vendor )
click_ceo     = boolean : ( evt_victim_click_ceo )
click_vendor  = boolean : ( evt_victim_click_vendor )
data_harvested = boolean : ( evt_ceo_form_submit and evt_vendor_form_submit )
lab_complete  = boolean : ( ceo_sent and vendor_sent and read_ceo and read_vendor and click_ceo and click_vendor and data_harvested )
