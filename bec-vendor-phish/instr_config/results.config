# results.config
evt_ceo_email_sent      = mail-server:webmail.log : CONTAINS : EMAIL_SENT from=ceo@company.vn to=finance@company.vn
evt_vendor_email_sent   = mail-server:webmail.log : CONTAINS : EMAIL_SENT from=vendor@abc-supply.vn to=finance@company.vn
evt_victim_read_ceo     = mail-server:webmail.log : CONTAINS : EMAIL_READ user=finance@company.vn from=ceo@company.vn
evt_victim_read_vendor  = mail-server:webmail.log : CONTAINS : EMAIL_READ user=finance@company.vn from=vendor@abc-supply.vn
evt_victim_click_ceo    = mail-server:webmail.log : CONTAINS : LINK_CLICK user=finance@company.vn type=ceo
evt_victim_click_vendor = mail-server:webmail.log : CONTAINS : LINK_CLICK user=finance@company.vn type=vendor
evt_ceo_form_submit     = mail-server:form_events.log : CONTAINS : FORM_SUBMIT type=ceo user=finance@company.vn
evt_vendor_form_submit  = mail-server:form_events.log : CONTAINS : FORM_SUBMIT type=vendor user=finance@company.vn
