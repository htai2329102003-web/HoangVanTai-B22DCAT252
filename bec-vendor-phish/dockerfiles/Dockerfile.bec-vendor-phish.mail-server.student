# Labtainers Dockerfile: mail-server
ARG registry
FROM $registry/labtainer.base3
ARG lab
ARG labdir
ARG imagedir
ARG user_name
ARG password
ARG apt_source
ENV APT_SOURCE $apt_source
RUN /usr/bin/apt-source.sh
ADD https://archive.ubuntu.com/ubuntu/project/ubuntu-archive-keyring.gpg /tmp/ubuntu-archive-keyring.gpg
RUN install -m 0644 /tmp/ubuntu-archive-keyring.gpg /usr/share/keyrings/ubuntu-archive-keyring.gpg && install -m 0644 /tmp/ubuntu-archive-keyring.gpg /etc/apt/trusted.gpg.d/ubuntu-archive-keyring.gpg && rm -f /tmp/ubuntu-archive-keyring.gpg
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-flask curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
ADD $labdir/$imagedir/sys_tar/sys.tar /
ADD $labdir/sys_$lab.tar.gz /
RUN useradd -ms /bin/bash $user_name && \
    echo "$user_name:$password" | chpasswd && \
    adduser $user_name sudo
USER $user_name
ENV HOME /home/$user_name
ADD $labdir/$imagedir/home_tar/home.tar $HOME
RUN rm -f $HOME/home.tar
ADD $labdir/$lab.tar.gz $HOME
USER root
EXPOSE 5000
CMD ["/bin/bash", "-c", "exec /sbin/init --log-target=journal 3>&1"]
