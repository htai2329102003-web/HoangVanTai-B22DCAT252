# instr_config/results.config - bai phish-cloak-delay
#
# Duong dan file o day la tuong doi so voi $HOME cua container.
# cloak_server.py ghi log ben vung vao cloak_server.log.

# DOC: Server cloaking da thuc su khoi dong.
# Dung log cua server thay vi .bash_history de tranh phu thuoc vao
# co che luu shell history cua tung phien Labtainer.
server_started = cloak_server.log : CONTAINS : [cloak_server] khoi dong

# DOC: Server tung ghi nhan mot luot truy cap bi dieu huong sang decoy.
bot_detected = cloak_server.log : CONTAINS : -> DECOY

# DOC: Server tung ghi nhan mot luot truy cap duoc dieu huong sang payload.
victim_redirect = cloak_server.log : CONTAINS : -> PAYLOAD

# DOC: Dem so lan moi loai dieu huong de giang vien de doi chieu.
decoy_count = cloak_server.log : STRING_COUNT : -> DECOY
payload_count = cloak_server.log : STRING_COUNT : -> PAYLOAD
