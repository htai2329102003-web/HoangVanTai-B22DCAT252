# instr_config/goals.config - bai phish-cloak-delay

# DOC: Sinh vien da khoi dong duoc server cloaking.
setup_done = boolean : ( server_started )

# DOC: Co che cloaking hoat dong - he thong tung dieu huong mot truy cap
# som sang trang decoy.
cloaking_detects_bot = boolean : ( bot_detected )

# DOC: Co che delay activation hoat dong - he thong tung dieu huong mot
# truy cap sau khi tre sang trang payload.
delay_activation_works = boolean : ( victim_redirect )

# DOC: Hoan thanh toan bo bai lab.
# Kiem tra truc tiep cac result tag goc de tranh phu thuoc vao goal trung gian.
lab_complete = boolean : ( server_started and bot_detected and victim_redirect )
