GLOBAL_SETTINGS
    REGISTRY meme23102003
    LAB_MASTER_SEED urlcloaking01
    CHECKWORK YES

NETWORK SCANNER_NET
    MASK 192.168.1.0/24
    GATEWAY 192.168.1.1

NETWORK USER_NET
    MASK 10.0.0.0/24
    GATEWAY 10.0.0.1

CONTAINER server
    USER ubuntu
    SCRIPT NONE
    TERMINALS 1
    SCANNER_NET 192.168.1.100
    USER_NET 10.0.0.100

CONTAINER scanner
    USER ubuntu
    SCRIPT NONE
    X11 YES
    XTERM ScannerBrowser open_site.sh
    SCANNER_NET 192.168.1.50

CONTAINER victim
    USER ubuntu
    SCRIPT NONE
    X11 YES
    XTERM VictimBrowser open_site.sh
    USER_NET 10.0.0.50
