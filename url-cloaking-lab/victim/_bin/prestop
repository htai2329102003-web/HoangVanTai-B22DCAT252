#!/usr/bin/env bash
# Verify the redirect and then fetch its local training destination.
set +e
headers="$(mktemp)"
body="$(mktemp)"
status="$(curl --noproxy '*' -sS -D "$headers" -o "$body" -w '%{http_code}' --max-time 5 http://10.0.0.100:8080/ 2>/dev/null)"
raw_location="$(awk 'BEGIN { IGNORECASE=1 } /^Location:/ { sub(/\r$/, ""); sub(/^[^:]*: */, ""); print; exit }' "$headers")"
# Strip scheme+host if present, keep only the path
location="$(printf '%s' "$raw_location" | sed -E 's#^https?://[^/]+##')"
if [ "$status" = "302" ] && [ "$location" = "/training-simulation" ]; then
    printf 'VICTIM_STATUS=302 LOCATION=/training-simulation\n'
else
    printf 'VICTIM_STATUS=%s LOCATION=%s\n' "${status:-000}" "${location:-missing}"
fi

if [ -n "$location" ]; then
    landing_status="$(curl --noproxy '*' -sS -o "$body" -w '%{http_code}' --max-time 5 "http://10.0.0.100:8080${location}" 2>/dev/null)"
else
    landing_status="000"
    : > "$body"
fi
if [ "$landing_status" = "200" ] && grep -q 'data-lab-marker="simulation-page"' "$body" 2>/dev/null; then
    printf 'LANDING_STATUS=200 SIMULATION_PAGE=1\n'
else
    printf 'LANDING_STATUS=%s SIMULATION_PAGE=0\n' "${landing_status:-000}"
fi
rm -f "$headers" "$body"

if grep -q 'firefox' "$HOME/.bash_history" 2>/dev/null; then
    printf 'VICTIM_BROWSER=1\n'
else
    printf 'VICTIM_BROWSER=0\n'
fi
