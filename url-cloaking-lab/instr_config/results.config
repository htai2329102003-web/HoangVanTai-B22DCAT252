# Current-state checks run by the student's `checkwork` command.
# Each prestop script emits one stable marker line. Keep the cw_ prefix.
#CHECK_TRUE: Scanner should receive HTTP 200 and the normal workspace page. Check the scanner IP and server log if this fails.
cw_scanner_normal = scanner:prestop.stdout : FILE_REGEX : SCANNER_STATUS=200 NORMAL_PAGE=1

#CHECK_TRUE: Victim should receive HTTP 302 with Location /training-simulation. Check the victim IP and redirect response if this fails.
cw_victim_redirect = victim:prestop.stdout : FILE_REGEX : VICTIM_STATUS=302 LOCATION=/training-simulation

#CHECK_TRUE: The local training destination should return HTTP 200 and show the simulation page.
cw_victim_landing = victim:prestop.stdout : FILE_REGEX : LANDING_STATUS=200 SIMULATION_PAGE=1

#CHECK_TRUE: The Flask service should be healthy on the dual-homed server.
cw_server_health = server:prestop.stdout : FILE_REGEX : SERVER_HEALTH=200 APP=ready

#CHECK_TRUE: Scanner workstation must have opened a browser session as part of the exercise.
cw_scanner_browser = scanner:prestop.stdout : FILE_REGEX : SCANNER_BROWSER=1

#CHECK_TRUE: Victim workstation must have opened a browser session as part of the exercise.
cw_victim_browser = victim:prestop.stdout : FILE_REGEX : VICTIM_BROWSER=1

#CHECK_TRUE: Server health must have been checked manually via curl as part of the exercise.
cw_server_curl = server:prestop.stdout : FILE_REGEX : SERVER_CURL_CHECK=1

# Historical result names for instructor grading/reporting.
scanner_normal = scanner:prestop.stdout : FILE_REGEX : SCANNER_STATUS=200 NORMAL_PAGE=1
victim_redirect = victim:prestop.stdout : FILE_REGEX : VICTIM_STATUS=302 LOCATION=/training-simulation
victim_landing = victim:prestop.stdout : FILE_REGEX : LANDING_STATUS=200 SIMULATION_PAGE=1
server_health = server:prestop.stdout : FILE_REGEX : SERVER_HEALTH=200 APP=ready
scanner_opened_browser = scanner:prestop.stdout : FILE_REGEX : SCANNER_BROWSER=1
victim_opened_browser = victim:prestop.stdout : FILE_REGEX : VICTIM_BROWSER=1
server_checked_health = server:prestop.stdout : FILE_REGEX : SERVER_CURL_CHECK=1

#CHECK_OK: All URL Cloaking checks passed: scanner normal page, victim 302 redirect, local training page, server health, and evidence of manual browser/curl checks.
