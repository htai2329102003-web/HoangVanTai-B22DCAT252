ARG registry
FROM $registry/labtainer.base
ARG labdir
ARG imagedir
ARG version
ARG lab
LABEL version=$version
ADD $labdir/$imagedir/sys_tar/sys.tar /
USER root
RUN useradd -m -s /bin/bash -u 1000 ubuntu || true
ENV HOME /home/ubuntu
RUN mkdir -p /home/ubuntu/.local/bin /home/ubuntu/.local/result && chown -R ubuntu:ubuntu /home/ubuntu
USER ubuntu
ADD $labdir/$imagedir/$lab.tar.gz /home/ubuntu
USER root
RUN sed -i 's/ubuntumirror.uc.nps.edu/archive.ubuntu.com/g' /etc/apt/sources.list* 2>/dev/null || true
RUN apt-get update && apt-get install -y --no-install-recommends python3-flask curl && rm -rf /var/lib/apt/lists/*
COPY webapp/ /opt/url-cloaking-lab/
COPY url-cloaking.service /etc/systemd/system/url-cloaking.service
RUN chmod -R a+rX /opt/url-cloaking-lab && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /etc/systemd/system/url-cloaking.service /etc/systemd/system/multi-user.target.wants/url-cloaking.service
