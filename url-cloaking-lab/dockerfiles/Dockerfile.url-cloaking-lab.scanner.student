ARG registry
FROM $registry/labtainer.firefox
ARG labdir
ARG imagedir
ARG version
ARG lab
LABEL version=$version
ADD $labdir/$imagedir/sys_tar/sys.tar /
USER root
RUN useradd -m -s /bin/bash -u 1000 ubuntu || true
ENV HOME /home/ubuntu
RUN mkdir -p /home/ubuntu/.local/bin /home/ubuntu/.local/result && chown -R ubuntu:ubuntu /home/ubuntu
USER ubuntu
ADD $labdir/$imagedir/$lab.tar.gz /home/ubuntu
USER root
RUN sed -i 's/ubuntumirror.uc.nps.edu/archive.ubuntu.com/g' /etc/apt/sources.list* 2>/dev/null || true
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
