# Ignore all existing Labtainer labs
/*

# Keep this gitignore
!/.gitignore

# Track only our custom lab
!/phish-cloak-delay/
!/phish-cloak-delay/**

# Ignore Labtainer build artifacts
/phish-cloak-delay/phish-cloak-delay/home_tar/
/phish-cloak-delay/phish-cloak-delay/sys_tar/
/phish-cloak-delay/phish-cloak-delay/*.tar.gz

# Ignore Python temporary files
/phish-cloak-delay/phish-cloak-delay/__pycache__/
*.pyc

# Track bec-vendor-phish lab
!/bec-vendor-phish/
!/bec-vendor-phish/**

# Ignore bec-vendor-phish build artifacts
/bec-vendor-phish/*/home_tar/
/bec-vendor-phish/*/sys_tar/
/bec-vendor-phish/*/*.tar.gz
/bec-vendor-phish/**/__pycache__/

# Track bec-vendor-phish lab
!/bec-vendor-phish/
!/bec-vendor-phish/**

# Ignore bec-vendor-phish build artifacts
/bec-vendor-phish/*/home_tar/
/bec-vendor-phish/*/sys_tar/
/bec-vendor-phish/*/*.tar.gz
/bec-vendor-phish/**/__pycache__/

# Track url-cloaking-lab
!/url-cloaking-lab/
!/url-cloaking-lab/**

# Ignore url-cloaking-lab build artifacts
/url-cloaking-lab/*/home_tar/
/url-cloaking-lab/*/sys_tar/
/url-cloaking-lab/*/*.tar.gz
/url-cloaking-lab/**/__pycache__/
