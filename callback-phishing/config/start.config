# Filename: start.config
# Lab: callback-phishing
# Purpose: isolated three-container Callback Phishing / TOAD simulation

GLOBAL_SETTINGS
    REGISTRY meme23102003
    BASE_REGISTRY labtainers
    LAB_MASTER_SEED callback-phishing_student_master_seed

# Internal-only Labtainer network.  No service in this lab requires Internet access.
NETWORK CALLBACK_NET
    MASK 172.21.0.0/24
    GATEWAY 172.21.0.100

# Attacker simulation container
CONTAINER attacker-srv
    USER ubuntu
    TERMINALS 1
    CALLBACK_NET 172.21.0.2

# Fake support/call-center simulation container
CONTAINER support-bot
    USER ubuntu
    TERMINALS 1
    CALLBACK_NET 172.21.0.3

# Victim workstation simulation container
CONTAINER victim-pc
    USER ubuntu
    TERMINALS 1
    CALLBACK_NET 172.21.0.4
