# goals.config -- callback-phishing
# Goal names follow the approved six-goal scenario for this lab.

# DOC: attacker sent the simulated billing-warning email and victim-pc received it.
email_sent = boolean : ( r_email_send_cmd and r_mail_started and r_mail_received and r_mail_read )

# DOC: victim-pc contacted the fake support-bot and the support service recorded the connection.
victim_called = boolean : ( r_support_started and r_support_call_cmd and r_victim_connected_support )

# DOC: support-bot delivered the scripted lab guidance and victim-pc launched the lab-only callback client.
script_delivered = boolean : ( r_guidance_sent and r_callback_client_cmd )

# DOC: the lab-only callback connection was established between victim-pc and attacker-srv.
shell_connected = boolean : ( r_listener_started and r_callback_sent and r_callback_connected )

# DOC: synthetic content from secret_data.txt reached attacker-srv and was recorded as received.
data_exfiltrated = boolean : ( r_data_received )

# DOC: all five stages above were completed.
lab_complete = boolean : ( email_sent and victim_called and script_delivered and shell_connected and data_exfiltrated )
