# results.config -- callback-phishing
# Format: result_tag = CONTAINER:file : OPERATOR : value
#
# Low-level evidence is intentionally split between command history and persistent
# lab logs.  Bash history proves the intended step was invoked; logs prove the
# corresponding event actually occurred inside the isolated lab network.

# --- attacker-srv ---
r_listener_started = attacker-srv:.bash_history : CONTAINS : python3 listener.py
r_email_send_cmd = attacker-srv:.bash_history : CONTAINS : python3 send_email.py
r_callback_connected = attacker-srv:attacker_callback.log : CONTAINS : CALLBACK_CONNECTED
r_data_received = attacker-srv:attacker_callback.log : CONTAINS : SECRET_DATA_RECEIVED

# --- support-bot ---
r_support_started = support-bot:.bash_history : CONTAINS : python3 chatbot_server.py
r_victim_connected_support = support-bot:support.log : CONTAINS : VICTIM_CONNECTED
r_guidance_sent = support-bot:support.log : CONTAINS : SUPPORT_GUIDANCE_SENT

# --- victim-pc ---
r_mail_started = victim-pc:.bash_history : CONTAINS : python3 mail_server.py
r_mail_read = victim-pc:.bash_history : CONTAINS : python3 read_mail.py
r_support_call_cmd = victim-pc:.bash_history : CONTAINS : python3 call_support.py
r_callback_client_cmd = victim-pc:.bash_history : CONTAINS : python3 callback_client.py
r_mail_received = victim-pc:victim_mail.log : CONTAINS : EMAIL_RECEIVED
r_callback_sent = victim-pc:victim_callback.log : CONTAINS : CALLBACK_SENT
