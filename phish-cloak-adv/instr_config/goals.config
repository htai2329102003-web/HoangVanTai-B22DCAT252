# instr_config/goals.config  |  phish-cloak-adv

# Muc 1: Ca hai server cua attacker da khoi dong
attacker_ready     = boolean : ( cloak_started and harvest_started )

# Muc 2: Email phishing da duoc gui va victim co the nhan
email_delivered    = boolean : ( email_sent and mail_started )

# Muc 3: Co che cloaking hoat dong - bot bi chan
cloaking_works     = boolean : ( scanner_blocked )

# Muc 4: Co che delay activation hoat dong - victim that vao uoc
delay_works        = boolean : ( victim_got_login )

# Muc 5: Thu thap credential thanh cong (muc tieu cuoi cua cuoc tan cong)
harvest_complete   = boolean : ( cred_harvested )

# Muc 6: Sinh vien da hoan thanh day du luong thu cong
victim_flow_done   = boolean : ( mail_read and url_clicked )

# Tong hop: hoan thanh toan bo bai lab
lab_complete       = boolean : ( attacker_ready and email_delivered and cloaking_works and delay_works and harvest_complete and victim_flow_done )
