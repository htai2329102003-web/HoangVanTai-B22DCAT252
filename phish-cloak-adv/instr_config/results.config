# instr_config/results.config  |  phish-cloak-adv
# Dinh dang (2 container): result_tag = CONTAINER : file : OPERATOR : value
# cloak_server.log va harvest_server.log la file log ben vung do
# tung server tu ghi vao $HOME, Labtainer tu thu thap.

# --- attacker-srv ---

# Sinh vien da khoi dong cloak_server
cloak_started   = attacker-srv:.bash_history : CONTAINS : python3 cloak_server.py

# Sinh vien da khoi dong harvest_server
harvest_started = attacker-srv:.bash_history : CONTAINS : python3 harvest_server.py

# Sinh vien da gui phishing email
email_sent      = attacker-srv:.bash_history : CONTAINS : python3 send_phish.py

# Bot/scanner bi nhan dien va dieu huong sang DECOY
scanner_blocked = attacker-srv:cloak_server.log : CONTAINS : -> DECOY

# Victim that duoc dieu huong sang trang LOGIN
victim_got_login = attacker-srv:cloak_server.log : CONTAINS : -> LOGIN

# Credential bi thu thap thanh cong
cred_harvested  = attacker-srv:harvest_server.log : CONTAINS : user=

# --- victim-pc ---

# Sinh vien da khoi dong mail_server
mail_started    = victim-pc:.bash_history : CONTAINS : python3 mail_server.py

# Sinh vien da doc email
mail_read       = victim-pc:.bash_history : CONTAINS : python3 read_mail.py

# Sinh vien da click url (chay browse.py)
url_clicked     = victim-pc:.bash_history : CONTAINS : python3 browse.py
