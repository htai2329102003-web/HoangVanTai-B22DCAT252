# Filename : start.config
# Lab: phish-cloak-adv

GLOBAL_SETTINGS

	LAB_MASTER_SEED phish-cloak-adv_student_master_seed

# Internal isolated network for the phishing simulation lab
NETWORK PHISH_NET
	MASK 172.20.0.0/24
	GATEWAY 172.20.0.100

# Attacker container
CONTAINER attacker-srv
	USER ubuntu
	TERMINALS 1
	PHISH_NET 172.20.0.2

# Victim container
CONTAINER victim-pc
	USER ubuntu
	TERMINALS 1
	PHISH_NET 172.20.0.3
